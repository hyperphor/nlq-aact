;;; Way config. Profiles: :dev :server :default (see hyperphor.way.config).

{:app-title "AACT NL Query"
 :app-main "hyperphor.nlq_aact.frontend.core.init"
 :dev-mode true ;TEMP #profile {:dev true :default false}
 :port #env PORT
 ;; Own stylesheet, loaded after way's fixed-css -- same mechanism okc uses
 ;; for its own okc.css. See resources/public/css/nlq-aact.css.
 :css ["/css/nlq-aact.css"]
 ;; DynamoDB log -- see hyperphor.nlq.generate/record 
 ;; :table must already exist (String partition key "uuid" --
 :nlq-log {:type :dynamo
            :table "nlq-log"
            :region "us-west-2"
           ;; auth is via standard env variables and that seems hard change
            }
 :nlq
 [;; AACT: public aggregate ClinicalTrials.gov data
  ;; (https://aact.ctti-clinicaltrials.org), a real Postgres db -- see
  ;; design/postgres.md.

  ;; :tables limits generation to a subset of the ctgov schema's 70+ tables
  ;; (see hyperphor.nlq-aact.schema-gen/
  ;; regenerate-schema, which generated resources/aact/schema.alz.edn from
  ;; these same tables' real FK constraints + AACT's own published data
  ;; dictionary).
  {:name "AACT"
   :db
   {:provider :postgres
    :host "aact-db.ctti-clinicaltrials.org"
    :port 5432
    :dbname "aact"
    :pg-schema "ctgov"
    :user #env AACT_USER
    :password #env AACT_PASSWORD
    :tables ["studies" "sponsors" "conditions" "interventions" "facilities"
             "outcomes" "eligibilities" "brief_summaries" "keywords" "design_groups"
             "calculated_values" "designs" "study_references" "reported_events"
             ;; Tier 1 remainder (design/aact-tables.md)
             "design_outcomes" "design_group_interventions" "reported_event_totals"
             ;; Tier 2 (design/aact-tables.md) -- mesh_terms/mesh_headings
             ;; deliberately not included, see that doc: no real FK ties them
             ;; to anything (browse_conditions/browse_interventions link by
             ;; text match on mesh_term, not id), so gen-alz-schema can't
             ;; wire them into the schema as a real relation.
             "outcome_measurements" "outcome_analyses" "outcome_analysis_groups" "result_groups"
             "browse_conditions" "browse_interventions"
             "baseline_measurements" "baseline_counts"
             "overall_officials"]
    :source-label "AACT (Postgres)"
    :source-url "https://aact.ctti-clinicaltrials.org"}
   :schema "aact/schema.alz.edn"
   :sql-dialect "PostgreSQL"
   :examples
   [{:nl "Show the 1000 most recent studies, in full", :sql "select * from studies ORDER BY study_first_posted_date DESC LIMIT 1000;", :prompt? false}
    ;; "Show full studies table" times out, no good

    {:nl "What conditions are studied most often?"
     :sql "select name, count(*) from conditions group by name order by count(*) desc limit 20"}
    {:nl "How many studies are recruiting for lung cancer?"
     :sql "select count(distinct s.nct_id) from studies s join conditions c on c.nct_id = s.nct_id where s.overall_status = 'RECRUITING' and c.downcase_name like '%lung cancer%'"}
    {:nl "Show phase III studies sponsored by Pfizer"
     :sql "select s.* from studies s join sponsors sp on sp.nct_id = s.nct_id where s.phase = 'PHASE3' and sp.name ilike '%pfizer%'"}
    {:nl "What are the most common interventions studied for melanoma?"}
    {:nl "Show facilities in California running studies for diabetes"}
    {:nl "What's the average enrollment for completed trials by phase?"}
    {:nl "what are the most common adverse events in prostate cancer trials"}
    {:nl "show the largest trials for melanoma that involved nivolumab"
     :sql "SELECT s.nct_id, s.brief_title, s.enrollment, i.name AS intervention_name, c.name AS condition_name
FROM ctgov.studies s
JOIN ctgov.conditions c ON s.nct_id = c.nct_id
JOIN ctgov.interventions i ON s.nct_id = i.nct_id
WHERE c.downcase_name LIKE '%melanoma%'
  AND i.name LIKE '%nivolumab%'
ORDER BY s.enrollment DESC;"}
    {:nl "show trials for schizophrenia with open enrollment in california. " ; Include relevant location and specific condition
     :sql "SELECT 
    s.nct_id,
    s.brief_title,
    c.name AS condition_name,
    f.name AS facility_name,
    f.city,
    f.state
FROM 
    ctgov.studies s
JOIN 
    ctgov.conditions c ON s.nct_id = c.nct_id
JOIN 
    ctgov.facilities f ON s.nct_id = f.nct_id
WHERE 
    c.downcase_name LIKE '%schizophrenia%'
    AND s.overall_status = 'RECRUITING'
    AND f.state = 'California';
"}

    ;; Added because it didn't always generate ADULT = TRUE, which may be a schema issue TODOa look into
    {:nl "show me currently recruiting trials for ulcerative colitis in adults with sites in north carolina."
     :sql "SELECT 
    s.nct_id,
    s.brief_title,
    c.name AS condition_name,
    f.name AS facility_name,
    f.city,
    f.state,
    e.minimum_age,
    e.maximum_age
FROM 
    ctgov.studies s
JOIN 
    ctgov.conditions c ON s.nct_id = c.nct_id
JOIN 
    ctgov.facilities f ON s.nct_id = f.nct_id
JOIN
    ctgov.eligibilities e ON s.nct_id = e.nct_id
WHERE 
    c.downcase_name LIKE '%ulcerative colitis%'
    AND s.overall_status = 'RECRUITING'
    AND f.state = 'North carolina'
    AND e.adult = TRUE;"}
    ;; Tier 2 tables (design/aact-tables.md) -- real posted results/stats,
    ;; not just study metadata.
    {:nl "Which melanoma trials showed a statistically significant overall survival benefit, based on p-value under 0.05?"
     :sql "SELECT o.nct_id, o.title AS outcome_title, oa.p_value, oa.param_value, oa.method, c.name AS condition_name
FROM ctgov.outcomes o
JOIN ctgov.outcome_analyses oa ON o.id = oa.outcome_id
JOIN ctgov.conditions c ON o.nct_id = c.nct_id
WHERE c.downcase_name LIKE '%melanoma%'
  AND (o.title ILIKE '%overall survival%' OR o.description ILIKE '%overall survival%')
  AND oa.p_value < 0.05;"}
    {:nl "Who are the principal investigators for melanoma trials at Stanford?"
     :sql "SELECT oo.name AS principal_investigator
FROM ctgov.studies s
JOIN ctgov.overall_officials oo ON s.nct_id = oo.nct_id
JOIN ctgov.facilities f ON s.nct_id = f.nct_id
JOIN ctgov.conditions c ON s.nct_id = c.nct_id
WHERE c.downcase_name LIKE '%melanoma%'
  AND f.name ILIKE '%stanford%'
  AND oo.role = 'PRINCIPAL_INVESTIGATOR';"}
    ;; eligibilities.criteria is free-text (the full inclusion/exclusion
    ;; block as written in the protocol), not structured fields -- this is a
    ;; keyword-search-over-prose pattern, not a guaranteed-precise filter.
    ;; See design conversation, 2026-08-25: verified live, 11 real hits.
    {:nl "Find melanoma trials where the eligibility criteria require the patient to have failed at least one prior treatment"
     :sql "SELECT s.nct_id, s.brief_title, e.criteria
FROM ctgov.studies s
JOIN ctgov.conditions c ON s.nct_id = c.nct_id
JOIN ctgov.eligibilities e ON s.nct_id = e.nct_id
WHERE c.downcase_name LIKE '%melanoma%'
  AND (e.criteria ILIKE '%failed prior treatment%'
       OR e.criteria ILIKE '%at least one prior therapy%'
       OR e.criteria ILIKE '%failure of previous treatment%');"}
    ;; From design/aact-paper-ideas.md (AACT's own paper, Tasneem et al 2012,
    ;; Figure 3): data completeness jumped after the Sept 2005 ICMJE
    ;; registration policy and (more modestly) the 2007 FDAAA mandate.
    ;; Verified live 2026-09-06: 1999 36.6% -> 2005 85.7% -> 2010 77.1%.
    {:nl "What percentage of studies reported masking information, by year, from 1999 to 2010?"
     :sql "SELECT extract(year from s.study_first_submitted_date)::int AS year,
       count(*) AS total_studies,
       count(d.masking) AS with_masking,
       round(100.0 * count(d.masking) / count(*), 1) AS pct_with_masking
FROM ctgov.studies s
LEFT JOIN ctgov.designs d ON d.nct_id = s.nct_id
WHERE s.study_first_submitted_date BETWEEN '1999-01-01' AND '2010-12-31'
GROUP BY year
ORDER BY year;"}
    ;; FDAAA also mandated *posting results*, not just registering -- still a
    ;; live compliance topic. Verified live 2026-09-06: real sponsors with
    ;; 0% posted results among 20+ completed, >2-year-old trials.
    {:nl "Which lead sponsors have the worst results-reporting compliance rate, among sponsors with at least 20 completed trials more than two years old?"
     :sql "SELECT sp.name AS sponsor,
       count(*) AS completed_trials,
       count(*) FILTER (WHERE cv.were_results_reported) AS with_results,
       round(100.0 * count(*) FILTER (WHERE cv.were_results_reported) / count(*), 1) AS pct_reported
FROM ctgov.studies s
JOIN ctgov.sponsors sp ON sp.nct_id = s.nct_id AND sp.lead_or_collaborator = 'lead'
JOIN ctgov.calculated_values cv ON cv.nct_id = s.nct_id
WHERE s.overall_status = 'COMPLETED'
  AND s.completion_date < CURRENT_DATE - INTERVAL '2 years'
GROUP BY sp.name
HAVING count(*) >= 20
ORDER BY pct_reported ASC
LIMIT 15;"}
    ;; Evidence-rigor query (paper's Discussion: "comparative distribution of
    ;; evidence levels across specialties/conditions"). Verified live
    ;; 2026-09-06: 4274 interventional melanoma trials, 7.8% both randomized
    ;; and blinded.
    {:nl "What percentage of interventional melanoma trials are both randomized and blinded?"
     :sql "SELECT count(*) AS total_trials,
       count(*) FILTER (WHERE d.allocation = 'RANDOMIZED') AS randomized,
       count(*) FILTER (WHERE d.masking != 'NONE') AS masked,
       count(*) FILTER (WHERE d.allocation = 'RANDOMIZED' AND d.masking != 'NONE') AS randomized_and_masked,
       round(100.0 * count(*) FILTER (WHERE d.allocation = 'RANDOMIZED' AND d.masking != 'NONE') / count(*), 1) AS pct
FROM ctgov.studies s
JOIN ctgov.conditions c ON c.nct_id = s.nct_id
JOIN ctgov.designs d ON d.nct_id = s.nct_id
WHERE c.downcase_name LIKE '%melanoma%'
  AND s.study_type = 'INTERVENTIONAL';"}
    ]
   :llm {:provider :openai
         :model "gpt-4o"
         :system "You are a medical researcher and clinical trials expert."}}]}
